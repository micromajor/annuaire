generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum ArtisanStatus {
  EN_ATTENTE
  VALIDE
  REJETE
}

// ---------------------------------------------------------------------------
// MODELS
// ---------------------------------------------------------------------------

model Artisan {
  id            String        @id @default(cuid())
  raisonSociale String?
  siret         String?       @unique
  prenom        String
  nom           String
  email         String        @unique
  telephone     String?
  siteWeb       String?
  logoUrl       String?       // URL du logo fournie par l'artisan
  accroche      String?       @db.VarChar(200)  // phrase d'accroche courte
  description   String?       @db.VarChar(2000)
  metierLibre   String?       // métier libre soumis par l'artisan s'il n'est pas dans la liste
  portfolioPhotos Json?        // tableau d'URLs de photos de chantier
  passwordHash  String?       // null = artisan sans compte (flux token uniquement)
  status          ArtisanStatus @default(EN_ATTENTE)
  hasPendingDraft Boolean       @default(false)
  draftData       Json?         // modifications en attente de validation
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // soft delete

  metiers    ArtisanMetier[]
  communes   ArtisanCommune[]
  contacts   ContactRequest[]
  editTokens         EditToken[]
  passwordResetTokens PasswordResetToken[]
  avis          Avis[]
  oauthAccounts OAuthAccount[]
  convsArtisan     Conversation[] @relation("ConvArtisan")
  convsParticulier Conversation[] @relation("ConvParticulier")
  signalements     Signalement[]
}

model Metier {
  id        String          @id @default(cuid())
  slug      String          @unique
  label     String
  categorie String?
  artisans  ArtisanMetier[]
}

model Commune {
  id         String           @id @default(cuid())
  nom        String
  codePostal String
  artisans   ArtisanCommune[]

  @@unique([nom, codePostal])
}

model ArtisanMetier {
  artisanId String
  metierId  String
  artisan   Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  metier    Metier  @relation(fields: [metierId], references: [id], onDelete: Cascade)

  @@id([artisanId, metierId])
}

model ArtisanCommune {
  artisanId String
  communeId String
  artisan   Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Cascade)

  @@id([artisanId, communeId])
}

model ContactRequest {
  id           String   @id @default(cuid())
  artisanId    String
  clientPrenom String
  clientNom    String
  clientEmail  String
  clientTel    String?
  message      String   @db.VarChar(1000)
  typeTraux    String
  avisToken    String?  @unique // token à usage unique pour laisser un avis
  avisUsed     Boolean  @default(false) // true une fois l'avis soumis
  photos       Json?    // tableau d'URLs de photos jointes à la demande
  createdAt    DateTime @default(now())

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
}

model Avis {
  id           String    @id @default(cuid())
  artisanId    String
  auteurPrenom String
  auteurEmail  String    // non affiché publiquement
  note         Int       // 1-5
  commentaire  String    @db.VarChar(800)
  status       String    @default("EN_ATTENTE") // EN_ATTENTE | VALIDE | REJETE
  createdAt    DateTime  @default(now())

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
}

model EditToken {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  artisanId  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  artisanId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
}

model Besoin {
  id          String   @id @default(cuid())
  artisanId   String?  // lien optionnel vers le compte particulier
  metierSlug  String
  commune     String
  description String   @db.VarChar(1000)
  prenom      String
  contact     String?  // contact via le site uniquement, non obligatoire
  photos      Json?    // tableau d'URLs (max 6)
  status      String   @default("NOUVEAU")
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// MESSAGERIE
// ---------------------------------------------------------------------------

model Conversation {
  id            String   @id @default(cuid())
  artisanId     String
  particulierId String
  sujet         String   @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artisan     Artisan   @relation("ConvArtisan", fields: [artisanId], references: [id], onDelete: Cascade)
  particulier Artisan   @relation("ConvParticulier", fields: [particulierId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([artisanId, particulierId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  expediteur     String   // "artisan" | "particulier"
  contenu        String   @db.VarChar(2000)
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// FICHIERS UPLOADÉS (stockés en base PostgreSQL)
// ---------------------------------------------------------------------------

model UploadedFile {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  contexte   String   // "portfolio" | "contact" | "besoin"
  uploaderId String?  // artisanId si upload authentifié, null sinon
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FEEDBACK BETA — Retours utilisateurs / signalements de bugs
// ---------------------------------------------------------------------------

model Feedback {
  id        String   @id @default(cuid())
  type      String   // "BUG" | "SUGGESTION" | "AUTRE"
  message   String   @db.VarChar(1000)
  pageUrl   String?  @db.VarChar(500) // page depuis laquelle le retour a été envoyé
  email     String?  // optionnel — pour pouvoir recontacter
  status    String   @default("NOUVEAU") // "NOUVEAU" | "LU" | "TRAITE"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// NEXTAUTH — OAuth accounts (Google, etc.)
// ---------------------------------------------------------------------------

model OAuthAccount {
  id                String  @id @default(cuid())
  artisanId         String
  provider          String  // "google"
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?

  artisan Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ---------------------------------------------------------------------------
// SIGNALEMENT — signalement d'une fiche artisan par un visiteur
// ---------------------------------------------------------------------------

model Signalement {
  id        String   @id @default(cuid())
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId String
  motif     String   @db.VarChar(500)
  email     String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}
