# Base de données PostgreSQL
# En prod avec Coolify : coller l'URL interne fournie par le service PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/annuaire_artisans?schema=public"

# Auth — NextAuth v5
# Générer avec : openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"   # même valeur (compat v4)
AUTH_URL="http://localhost:3000"     # en prod : https://mondomaine.fr
NEXTAUTH_URL="http://localhost:3000" # en prod : https://mondomaine.fr

# Email transactionnel (Resend — https://resend.com)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@votredomaine.fr"

# Accès admin back-office
ADMIN_EMAIL="admin@votredomaine.fr"
ADMIN_PASSWORD="your-secure-password"

# Google OAuth (https://console.cloud.google.com)
# Redirect URI à ajouter : https://mondomaine.fr/api/auth/callback/google
GOOGLE_CLIENT_ID="votre-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-votre-secret"

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
